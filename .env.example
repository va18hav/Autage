# Required master key (Fernet) for encrypting credentials at rest.
# The app will not start unless this is set to a valid Fernet key.
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTAGE_SECRET_KEY=

# Required JWT signing secret. Must be different from all other secrets.
# Generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Session lifetime in minutes. Defaults to 24 hours.
JWT_EXPIRE_MINUTES=1440

# Postgres incident worker defaults.
WORKER_POLL_SECONDS=1
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_DELAY_SECONDS=30
WORKER_JOB_TIMEOUT_SECONDS=900

# Bootstrap/recovery token used to create the first user and reset the
# administrator password. Keep it secret. Generate with:
# uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTAGE_SETUP_TOKEN=

# Public hostname Caddy serves. `localhost` uses Caddy's local HTTPS CA.
# For a real deployment, point DNS at the host and set this to the DNS name.
AUTAGE_HOST=localhost

# Use ./deploy/Caddyfile.internal for a private DNS name, VM IP, or internal
# certificate instead of public automatic HTTPS.
# CADDYFILE=./deploy/Caddyfile.internal

# Compose serves the app over HTTPS; keep this true there.
# Set false only when running the API directly over plain HTTP for development.
COOKIE_SECURE=True
CORS_ORIGINS=https://localhost,http://localhost:5173,http://127.0.0.1:5173

# Optional fallback Gemini key if no provider credentials are saved in the DB
GOOGLE_API_KEY=

# Kubernetes connection (API URL, read-only ServiceAccount token, and the
# cluster CA certificate) is stored encrypted in the DB via Settings → Kubernetes.
# TLS verification of the API server is always on — no skip-verify option exists.

REDIS_URL=redis://localhost:6379/0
DB_HOST=localhost
DB_PORT=5432
DB_USER=autage
# Required. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DB_PASSWORD=
DB_NAME=autage

# Master key (Fernet) for encrypting credentials at rest.
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTAGE_SECRET_KEY=

# JWT signing secret (falls back to AUTAGE_SECRET_KEY if unset)
JWT_SECRET_KEY=
COOKIE_SECURE=False
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fallback webhook secret if none has been generated in the Integrations UI yet
WEBHOOK_SECRET=autage-webhook-secret

# Optional fallback Gemini key if no provider credentials are saved in the DB
GOOGLE_API_KEY=

# Kubernetes connection (API URL, read-only ServiceAccount token, and the
# cluster CA certificate) is stored encrypted in the DB via Settings → Kubernetes.
# TLS verification of the API server is always on — no skip-verify option exists.

REDIS_URL=redis://localhost:6379/0
DB_HOST=localhost
DB_PORT=5432
DB_USER=autage
DB_PASSWORD=autage_password
DB_NAME=autage

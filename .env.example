# Copy to .env and fill in. API keys for LLM providers are managed in the
# dashboard (Settings → Integrations) and stored encrypted — this file only
# holds infrastructure + bootstrap secrets.

# Webhook HMAC shared secret (used by alert sources to sign payloads)
WEBHOOK_SECRET=Autage-webhook-secret

# Optional legacy bridge: lets the default Gemini pipeline run before any key
# is saved in the UI. DB credentials always take precedence.
GOOGLE_API_KEY=

# Master key (Fernet) encrypting credentials at rest. Generate once:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTAGE_SECRET_KEY=

# Mock kubectl for local/demo runs without a real cluster
MOCK_KUBECTL=True

REDIS_URL=redis://localhost:6379/0
DB_HOST=localhost
DB_PORT=5432
DB_USER=autage
DB_PASSWORD=autage_password
DB_NAME=autage
